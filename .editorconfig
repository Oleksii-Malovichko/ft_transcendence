root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces mean "line break" in Markdown, so keep them.
trim_trailing_whitespace = false

[Makefile]
# make requires real tab characters.
indent_style = tab