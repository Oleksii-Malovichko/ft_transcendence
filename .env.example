# ── PostgreSQL (the `db` container creates this user and database) ──────────
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=change-me
POSTGRES_DB=transcendence

# ── Backend (NestJS) ─────────────────────────────────────────────────────────
# Port the API listens on during local development (Next.js uses 3000).
API_PORT=3001

# How the backend reaches the database. Must repeat the values above.
# Local development: the db container is published on localhost:5432.
# Inside Docker (next sprint) the host part becomes `db` instead of localhost.
DATABASE_URL=postgresql://transcendence:change-me@localhost:5432/transcendence