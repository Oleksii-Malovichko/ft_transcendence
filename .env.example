
# ── PostgreSQL (the `db` container creates this user and database) ──────────
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=change-me
POSTGRES_DB=transcendence

# ── Backend (NestJS) ─────────────────────────────────────────────────────────
# development | production | test. The Docker image sets "production" itself.
NODE_ENV=development

# Port the API listens on during local development (Next.js uses 3000).
API_PORT=3001

DATABASE_URL=postgresql://transcendence:change-me@localhost:5432/transcendence

# ── Reverse proxy (nginx): the ports published on your machine ──────────────
# Open https://localhost:<HTTPS_PORT> in the browser. 8443 and 8080 work
# without admin rights; use 443 and 80 if your Docker may bind those ports.
HTTPS_PORT=8443
HTTP_PORT=8080
 
JWT_SECRET=change-me-to-the-output-of-openssl-rand-hex-32

