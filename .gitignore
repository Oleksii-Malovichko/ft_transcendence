.env
.env.*
!.env.example
!apps/web/.env.development

# ── Runtime data created by Docker volumes / the app ────────────────────────
infra/nginx/certs/
uploads/

# ── Tests & tooling ──────────────────────────────────────────────────────────
coverage/
*.log

# ── OS / editor noise ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/