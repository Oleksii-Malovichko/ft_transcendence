
# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Build output ─────────────────────────────────────────────────────────────
dist/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# ── Generated code (always re-created by a command, never edited) ───────────
apps/api/src/generated/

