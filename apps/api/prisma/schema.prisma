// The client is generated as TypeScript INSIDE src/, so Nest compiles it with
// our code. It is git-ignored: `pnpm --filter @ft/api db:generate` rebuilds it.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm" // the backend is an ES-module project
  importFileExtension = "js" //  "nodenext" requires ./file.js in imports
}

// Since Prisma 7 the connection URL is NOT here: the CLI reads it from
// prisma.config.ts and the running app passes it in PrismaService.
datasource db {
  provider = "postgresql"
}

/// A person who can log in and play.
/// Profile fields (display name, avatar, 42 id) are added later by ME-2.
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  /// argon2id hash; the plain password is never stored.
  /// Null for accounts that only sign in with 42: there is no password to check.
  passwordHash String?  @map("password_hash")
  /// The 42 account this user signs in with, when they use 42.
  fortyTwoId   Int?     @unique @map("forty_two_id")
  /// The name other players see. Unique, so two people can't be mistaken
  /// for each other. Empty until the user picks one on their profile.
  displayName  String?  @unique @map("display_name")
  /// Set once an avatar has been uploaded; everyone else gets a default one.
  hasAvatar    Boolean  @default(false) @map("has_avatar")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  /// Games this user played, on one side or the other.
  matchesAsLeft     Match[]            @relation("LeftPlayer")
  matchesAsRight    Match[]            @relation("RightPlayer")
  /// Tournaments this user registered for.
  tournamentSeats   TournamentPlayer[]
  /// The people this user added, and the people who added this user.
  friends           Friendship[]       @relation("Owner")
  friendOf          Friendship[]       @relation("Friend")
  conversationsLow  Conversation[]     @relation("ConversationLow")
  conversationsHigh Conversation[]     @relation("ConversationHigh")
  sentMessages      Message[]          @relation("MessageSender")
  blocks            UserBlock[]        @relation("Blocker")
  blockedBy         UserBlock[]        @relation("Blocked")

  @@map("users")
}

/// One finished game, kept so profiles can show a match history.
///
/// Both players are optional: a local game or a game against the AI may have
/// no logged-in player at all, and a match must survive the deletion of an
/// account (the row stays, the link becomes null).
model Match {
  id          Int      @id @default(autoincrement())
  /// "local", "ai" or "remote".
  mode        String
  leftUserId  Int?     @map("left_user_id")
  rightUserId Int?     @map("right_user_id")
  leftScore   Int      @map("left_score")
  rightScore  Int      @map("right_score")
  /// "left" or "right": the side that reached the score limit.
  winner      String
  playedAt    DateTime @default(now()) @map("played_at")

  leftUser  User? @relation("LeftPlayer", fields: [leftUserId], references: [id], onDelete: SetNull)
  rightUser User? @relation("RightPlayer", fields: [rightUserId], references: [id], onDelete: SetNull)

  @@index([leftUserId])
  @@index([rightUserId])
  @@map("matches")
}

/// A single-elimination tournament: 4 or 8 players, one winner.
///
/// The bracket itself is not stored: it follows from the seats, and core
/// rebuilds it (tournament/bracket.ts). Storing both would mean keeping two
/// truths in step, and they would drift the first time something crashed.
model Tournament {
  id        Int      @id @default(autoincrement())
  name      String
  /// 4 or 8.
  size      Int
  /// "open" while players register, then "running", then "finished".
  status    String   @default("open")
  createdAt DateTime @default(now()) @map("created_at")

  players TournamentPlayer[]
  results TournamentResult[]

  @@map("tournaments")
}

/// One seat in a tournament. The alias is the name shown in the bracket,
/// which the subject asks for; a guest can hold a seat without an account.
model TournamentPlayer {
  id           Int    @id @default(autoincrement())
  tournamentId Int    @map("tournament_id")
  userId       Int?   @map("user_id")
  alias        String
  /// Position in the bracket, 0-based: seats 0 and 1 meet in the first round.
  seat         Int

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// No two aliases, no two accounts and no two players on the same seat.
  @@unique([tournamentId, alias])
  @@unique([tournamentId, userId])
  @@unique([tournamentId, seat])
  @@map("tournament_players")
}

/// The outcome of one bracket match. The bracket itself is still rebuilt from
/// the seats; these rows only say who won where, which is the one thing that
/// cannot be worked out from anything else.
model TournamentResult {
  id           Int      @id @default(autoincrement())
  tournamentId Int      @map("tournament_id")
  round        Int
  slot         Int
  winnerAlias  String   @map("winner_alias")
  decidedAt    DateTime @default(now()) @map("decided_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  /// A match is decided once.
  @@unique([tournamentId, round, slot])
  @@map("tournament_results")
}

/// Somebody's contact list. One row is one direction: adding a player puts
/// them on your list without asking them, and their list is their own. A
/// mutual "request and accept" dance would be a different feature; this one
/// is what the subject asks for — see who you play with, and whether they
/// are online right now.
model Friendship {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  friendId  Int      @map("friend_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User @relation("Owner", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("Friend", fields: [friendId], references: [id], onDelete: Cascade)

  /// The same person cannot be added twice.
  @@unique([userId, friendId])
  @@map("friendships")
}

/// A private conversation between exactly two users. The application stores
/// the smaller user ID first so each pair has only one conversation.
model Conversation {
  id         Int      @id @default(autoincrement())
  userLowId  Int      @map("user_low_id")
  userHighId Int      @map("user_high_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  userLow  User      @relation("ConversationLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh User      @relation("ConversationHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userLowId, userHighId])
  @@index([userLowId, updatedAt])
  @@index([userHighId, updatedAt])
  @@map("conversations")
}

/// A persisted direct message.
model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int      @map("conversation_id")
  senderId       Int      @map("sender_id")
  body           String   @db.VarChar(1000)
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, id])
  @@map("messages")
}

/// A directional block: the blocker decides whose messages and game invites
/// they no longer receive.
model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int      @map("blocker_id")
  blockedId Int      @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}
