generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm" // the backend is an ES-module project
  importFileExtension = "js" //  "nodenext" requires ./file.js in imports
}

// Since Prisma 7 the connection URL is NOT here: the CLI reads it from
// prisma.config.ts and the running app passes it in PrismaService.
datasource db {
  provider = "postgresql"
}

/// A person who can log in and play.
/// Profile fields (display name, avatar, 42 id) are added later by ME-2.
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  /// argon2id hash; the plain password is never stored.
  passwordHash String?  @map("password_hash")
  fortyTwoId   Int?     @unique @map("forty_two_id")
  displayName  String?  @unique @map("display_name")
  hasAvatar    Boolean  @default(false) @map("has_avatar")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  /// Games this user played, on one side or the other.
  matchesAsLeft  Match[] @relation("LeftPlayer")
  matchesAsRight Match[] @relation("RightPlayer")
  tournamentSeats TournamentPlayer[]

  @@map("users")
}

model Match {
  id          Int      @id @default(autoincrement())
  /// "local", "ai" or "remote".
  mode        String
  leftUserId  Int?     @map("left_user_id")
  rightUserId Int?     @map("right_user_id")
  leftScore   Int      @map("left_score")
  rightScore  Int      @map("right_score")
  /// "left" or "right": the side that reached the score limit.
  winner      String
  playedAt    DateTime @default(now()) @map("played_at")

  leftUser  User? @relation("LeftPlayer", fields: [leftUserId], references: [id], onDelete: SetNull)
  rightUser User? @relation("RightPlayer", fields: [rightUserId], references: [id], onDelete: SetNull)

  @@index([leftUserId])
  @@index([rightUserId])
  @@map("matches")
}

/// A single-elimination tournament: 4 or 8 players, one winner.
///
/// The bracket itself is not stored: it follows from the seats, and core
/// rebuilds it (tournament/bracket.ts). Storing both would mean keeping two
/// truths in step, and they would drift the first time something crashed.
model Tournament {
  id        Int      @id @default(autoincrement())
  name      String
  /// 4 or 8.
  size      Int
  /// "open" while players register, then "running", then "finished".
  status    String   @default("open")
  createdAt DateTime @default(now()) @map("created_at")

  players TournamentPlayer[]
  results TournamentResult[]

  @@map("tournaments")
}

/// One seat in a tournament. The alias is the name shown in the bracket,
/// which the subject asks for; a guest can hold a seat without an account.
model TournamentPlayer {
  id           Int    @id @default(autoincrement())
  tournamentId Int    @map("tournament_id")
  userId       Int?   @map("user_id")
  alias        String
  /// Position in the bracket, 0-based: seats 0 and 1 meet in the first round.
  seat         Int

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// No two aliases, no two accounts and no two players on the same seat.
  @@unique([tournamentId, alias])
  @@unique([tournamentId, userId])
  @@unique([tournamentId, seat])
  @@map("tournament_players")
}

/// The outcome of one bracket match. The bracket itself is still rebuilt from
/// the seats; these rows only say who won where, which is the one thing that
/// cannot be worked out from anything else.
model TournamentResult {
  id           Int      @id @default(autoincrement())
  tournamentId Int      @map("tournament_id")
  round        Int
  slot         Int
  winnerAlias  String   @map("winner_alias")
  decidedAt    DateTime @default(now()) @map("decided_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  /// A match is decided once.
  @@unique([tournamentId, round, slot])
  @@map("tournament_results")
}