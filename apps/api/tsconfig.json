{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,

    "outDir": "./dist",
    "rootDir": ".",
    "sourceMap": true, //       stack traces point to .ts lines, not compiled .js
    "removeComments": true, //  comments are for us, not for the compiled output
    "incremental": true,
    "types": ["node"]
  }
}
